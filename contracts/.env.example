# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# A Sepolia RPC endpoint. Free options: https://sepolia.drpc.org , Alchemy, Infura.
SEPOLIA_RPC_URL=https://sepolia.drpc.org

# Private key of a TEST wallet funded with Sepolia ETH (from a faucet).
# ⚠️ Use a throwaway key. Never a real-funds wallet.
SEPOLIA_PRIVATE_KEY=0xyour_test_private_key_here
